# Эти переменные добавляет Vercel КВ автоматически, когда вы подключаете
# интеграцию "Vercel KV" (или Upstash Redis) в панели проекта на Vercel.
# Ничего вручную вписывать не нужно, если подключите интеграцию через Dashboard.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Пароль для входа в /admin — придумайте свой и впишите в Vercel → Settings → Environment Variables
ADMIN_PASSWORD=change-me
